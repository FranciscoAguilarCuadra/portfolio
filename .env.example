# Configuración del formulario de contacto (Vercel > Project > Settings > Environment Variables)

# Obligatoria: API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: correo que recibe los mensajes (por defecto el del portfolio)
